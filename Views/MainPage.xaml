<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GratingPlayer.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light"
    FontSize="{StaticResource AppFontSize}"
    FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
    Foreground="{StaticResource InkBrush}">

    <Grid x:Name="RootGrid" Background="{StaticResource PageBgBrush}">

        <Canvas
            x:Name="LayoutCanvas"
            Width="689"
            Height="690"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource PageBgBrush}">

            <ComboBox
                x:Name="SchemeCombo"
                Canvas.Left="63"
                Canvas.Top="28"
                Width="565"
                Height="34"
                MaxDropDownHeight="300"
                FontSize="{StaticResource AppFontSize}"
                PlaceholderText="选择方案…"
                SelectionChanged="SchemeCombo_SelectionChanged" />

            <Border
                x:Name="ParamsPanel"
                Canvas.Left="62"
                Canvas.Top="74"
                Width="566"
                Height="480"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceLineBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Canvas>
                        <TextBlock
                            x:Name="FolderLabel"
                            Canvas.Left="25"
                            Canvas.Top="30"
                            Style="{StaticResource FieldLabel}"
                            Text="播放目录：" />
                        <TextBox
                            x:Name="FolderTextBox"
                            Canvas.Left="110"
                            Canvas.Top="25"
                            Width="355"
                            Height="34"
                            FontSize="{StaticResource AppFontSize}"
                            PlaceholderText="浏览或粘贴目录路径…"
                            LostFocus="FolderTextBox_LostFocus"
                            TextChanged="FolderTextBox_TextChanged" />
                        <Button
                            x:Name="BrowseButton"
                            Canvas.Left="470"
                            Canvas.Top="25"
                            Width="74"
                            Height="34"
                            Padding="4,0"
                            Content="浏览…"
                            Click="BrowseFolder_Click"
                            Style="{StaticResource Action}" />

                        <CheckBox
                            x:Name="IncludeSubdirsCheckBox"
                            Canvas.Left="110"
                            Canvas.Top="66"
                            Content="包含多级子文件夹"
                            FontSize="{StaticResource AppFontSize}"
                            Foreground="{StaticResource InkBrush}"
                            MinHeight="28"
                            VerticalContentAlignment="Center"
                            Checked="MonitorOption_Changed"
                            Unchecked="MonitorOption_Changed" />

                        <CheckBox
                            x:Name="WatchNewFilesCheckBox"
                            Canvas.Left="110"
                            Canvas.Top="95"
                            Content="监控实时新增图片"
                            FontSize="{StaticResource AppFontSize}"
                            Foreground="{StaticResource InkBrush}"
                            MinHeight="28"
                            VerticalContentAlignment="Center"
                            Checked="WatchNewFilesCheckBox_Changed"
                            Unchecked="WatchNewFilesCheckBox_Changed" />

                        <TextBlock
                            x:Name="AppendParenLeft"
                            Canvas.Left="260"
                            Canvas.Top="99"
                            Style="{StaticResource FieldLabel}"
                            Text="（" />
                        <RadioButton
                            x:Name="AppendEndRadio"
                            Canvas.Left="278"
                            Canvas.Top="93"
                            Content="追加到末尾"
                            FontSize="{StaticResource AppFontSize}"
                            Foreground="{StaticResource InkBrush}"
                            GroupName="AppendMode"
                            MinHeight="28"
                            Padding="8,0,0,0"
                            VerticalAlignment="Top"
                            VerticalContentAlignment="Center"
                            Checked="AppendModeRadio_Changed" />
                        <RadioButton
                            x:Name="AppendNextRadio"
                            Canvas.Left="400"
                            Canvas.Top="93"
                            Content="追加到下一个"
                            FontSize="{StaticResource AppFontSize}"
                            Foreground="{StaticResource InkBrush}"
                            GroupName="AppendMode"
                            MinHeight="28"
                            Padding="8,0,0,0"
                            VerticalAlignment="Top"
                            VerticalContentAlignment="Center"
                            Checked="AppendModeRadio_Changed" />
                        <TextBlock
                            x:Name="AppendParenRight"
                            Canvas.Left="528"
                            Canvas.Top="99"
                            Style="{StaticResource FieldLabel}"
                            Text="）" />

                        <TextBlock
                            x:Name="PlayOrderLabel"
                            Canvas.Left="26"
                            Canvas.Top="137"
                            Style="{StaticResource FieldLabel}"
                            Text="播放顺序："
                            ToolTipService.ToolTip="首次读取目录时的文件顺序" />
                        <ComboBox
                            x:Name="PlayOrderCombo"
                            Canvas.Left="111"
                            Canvas.Top="132"
                            Width="354"
                            Height="34"
                            FontSize="{StaticResource AppFontSize}"
                            MaxDropDownHeight="300"
                            SelectionChanged="PlayOrderCombo_SelectionChanged">
                            <ComboBoxItem Content="默认文件顺序" Tag="AsRead" />
                            <ComboBoxItem Content="文件名-正序" Tag="NameAsc" />
                            <ComboBoxItem Content="文件名-倒序" Tag="NameDesc" />
                            <ComboBoxItem Content="创建时间-正序" Tag="CreatedAsc" />
                            <ComboBoxItem Content="创建时间-倒序" Tag="CreatedDesc" />
                            <ComboBoxItem Content="最后修改时间-正序" Tag="ModifiedAsc" />
                            <ComboBoxItem Content="最后修改时间-倒序" Tag="ModifiedDesc" />
                        </ComboBox>

                        <TextBlock
                            x:Name="PlayModeLabel"
                            Canvas.Left="26"
                            Canvas.Top="178"
                            Style="{StaticResource FieldLabel}"
                            Text="播放方式：" />
                        <ComboBox
                            x:Name="PlayModeCombo"
                            Canvas.Left="111"
                            Canvas.Top="173"
                            Width="354"
                            Height="34"
                            FontSize="{StaticResource AppFontSize}"
                            MaxDropDownHeight="300"
                            SelectionChanged="PlayModeCombo_SelectionChanged">
                            <ComboBoxItem Content="连续播放（依次循环播放）" Tag="Auto" />
                            <ComboBoxItem Content="待机后播放（屏幕空闲指定时长后播放）" Tag="IdleStandby" />
                            <ComboBoxItem Content="新图播放（来新图，播新图）" Tag="NewImageOnly" />
                        </ComboBox>

                        <!-- 空闲行：与其它行间距一致（+41）；默认按无空闲排布，显示时再下移后续行 -->
                        <TextBlock
                            x:Name="IdleSecondsLabel"
                            Canvas.Left="26"
                            Canvas.Top="219"
                            Style="{StaticResource FieldLabel}"
                            Text="空闲秒数："
                            Visibility="Collapsed" />
                        <NumberBox
                            x:Name="IdleSecondsBox"
                            Canvas.Left="111"
                            Canvas.Top="214"
                            Width="354"
                            FontSize="{StaticResource AppFontSize}"
                            Minimum="5"
                            Maximum="3600"
                            SmallChange="5"
                            SpinButtonPlacementMode="Compact"
                            Visibility="Collapsed"
                            ValueChanged="IdleSecondsBox_ValueChanged" />
                        <TextBlock
                            x:Name="IdleSecondsUnit"
                            Canvas.Left="470"
                            Canvas.Top="219"
                            Style="{StaticResource UnitLabel}"
                            Text="秒"
                            Visibility="Collapsed" />

                        <TextBlock
                            x:Name="PlaybackDisplayLabel"
                            Canvas.Left="26"
                            Canvas.Top="219"
                            Style="{StaticResource FieldLabel}"
                            Text="播放屏幕：" />
                        <ComboBox
                            x:Name="PlaybackDisplayCombo"
                            Canvas.Left="111"
                            Canvas.Top="214"
                            Width="354"
                            Height="34"
                            FontSize="{StaticResource AppFontSize}"
                            MaxDropDownHeight="300"
                            DropDownOpened="PlaybackDisplayCombo_DropDownOpened"
                            SelectionChanged="PlaybackDisplayCombo_SelectionChanged" />

                        <Rectangle
                            x:Name="AnimDivider"
                            Canvas.Left="26"
                            Canvas.Top="257"
                            Width="518"
                            Height="1"
                            Fill="#E5E7EB" />

                        <TextBlock
                            x:Name="AnimParamsLabel"
                            Canvas.Left="26"
                            Canvas.Top="271"
                            Style="{StaticResource SectionLabel}"
                            Text="动画参数" />
                        <TextBlock
                            x:Name="StripTypeLabel"
                            Canvas.Left="111"
                            Canvas.Top="271"
                            Style="{StaticResource FieldLabel}"
                            Text="条纹类型：" />
                        <ComboBox
                            x:Name="StripOrientationCombo"
                            Canvas.Left="196"
                            Canvas.Top="266"
                            Width="269"
                            Height="34"
                            FontSize="{StaticResource AppFontSize}"
                            MaxDropDownHeight="300"
                            SelectionChanged="StripOrientationCombo_SelectionChanged">
                            <ComboBoxItem Content="竖条纹" Tag="Vertical" />
                            <ComboBoxItem Content="横条纹" Tag="Horizontal" />
                        </ComboBox>

                        <TextBlock
                            x:Name="StripCountLabel"
                            Canvas.Left="111"
                            Canvas.Top="312"
                            Style="{StaticResource FieldLabel}"
                            Text="条纹数量：" />
                        <NumberBox
                            x:Name="StripCountBox"
                            Canvas.Left="196"
                            Canvas.Top="307"
                            Width="269"
                            FontSize="{StaticResource AppFontSize}"
                            Minimum="1"
                            Maximum="200"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="StripCountBox_ValueChanged" />

                        <!-- 数值框右缘与上方 111+354=465 对齐；「秒」在 470 -->
                        <TextBlock
                            x:Name="FlipDurationLabel"
                            Canvas.Left="111"
                            Canvas.Top="353"
                            Style="{StaticResource FieldLabel}"
                            Text="动画时长："
                            ToolTipService.ToolTip="单次动画用时" />
                        <NumberBox
                            x:Name="FlipDurationBox"
                            Canvas.Left="196"
                            Canvas.Top="348"
                            Width="269"
                            FontSize="{StaticResource AppFontSize}"
                            Minimum="0.12"
                            Maximum="5"
                            SmallChange="0.05"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="FlipDurationBox_ValueChanged" />
                        <TextBlock
                            x:Name="FlipDurationUnit"
                            Canvas.Left="470"
                            Canvas.Top="353"
                            Style="{StaticResource UnitLabel}"
                            Text="秒" />

                        <TextBlock
                            x:Name="DwellLabel"
                            Canvas.Left="111"
                            Canvas.Top="394"
                            Style="{StaticResource FieldLabel}"
                            Text="停留时长："
                            ToolTipService.ToolTip="动画结束后停留时间" />
                        <NumberBox
                            x:Name="DwellBox"
                            Canvas.Left="196"
                            Canvas.Top="389"
                            Width="269"
                            FontSize="{StaticResource AppFontSize}"
                            Minimum="0.5"
                            Maximum="30"
                            SmallChange="0.5"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="DwellBox_ValueChanged" />
                        <TextBlock
                            x:Name="DwellUnit"
                            Canvas.Left="470"
                            Canvas.Top="394"
                            Style="{StaticResource UnitLabel}"
                            Text="秒" />
                    </Canvas>

                    <Border
                        x:Name="SchemeLockOverlay"
                        Background="Transparent"
                        Visibility="Collapsed"
                        Tapped="SchemeLockOverlay_Tapped" />
                </Grid>
            </Border>

            <Grid
                Canvas.Left="62"
                Canvas.Top="560"
                Width="566"
                Height="28">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <HyperlinkButton
                        x:Name="SchemeManageLink"
                        Style="{StaticResource SchemeLink}"
                        Click="SchemeManageLink_Click">
                        <TextBlock
                            Text="方案管理"
                            FontSize="{StaticResource AppFontSize}"
                            TextDecorations="Underline"
                            Foreground="{StaticResource LinkBlueBrush}" />
                    </HyperlinkButton>
                    <HyperlinkButton
                        x:Name="SaveSchemeLink"
                        Style="{StaticResource SchemeLink}"
                        Click="SaveSchemeLink_Click">
                        <TextBlock
                            Text="存储到新方案"
                            FontSize="{StaticResource AppFontSize}"
                            TextDecorations="Underline"
                            Foreground="{StaticResource LinkBlueBrush}" />
                    </HyperlinkButton>
                </StackPanel>
                <HyperlinkButton
                    x:Name="EditCurrentLink"
                    Style="{StaticResource SchemeLink}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="EditCurrentLink_Click">
                    <TextBlock
                        Text="修改当前设置"
                        FontSize="{StaticResource AppFontSize}"
                        TextDecorations="Underline"
                        Foreground="{StaticResource LinkBlueBrush}" />
                </HyperlinkButton>
            </Grid>

            <!-- 与播放按钮纵向居中齐平、左对齐 -->
            <TextBlock
                x:Name="ImageCountText"
                Canvas.Left="63"
                Canvas.Top="612"
                Width="160"
                FontSize="{StaticResource AppFontSize}"
                VerticalAlignment="Center"
                Foreground="{StaticResource PrimaryBrush}"
                Text="图片数量：—" />

            <TextBlock
                x:Name="HintText"
                Visibility="Collapsed"
                Text="" />
            <TextBlock
                x:Name="StatusText"
                Visibility="Collapsed"
                Text="" />

            <Button
                x:Name="PrimaryActionButton"
                Canvas.Left="234"
                Canvas.Top="600"
                Width="222"
                Height="46"
                Content="播放"
                Click="PlayNow_Click"
                Style="{StaticResource PrimaryAction}" />
        </Canvas>

        <Border
            x:Name="ModeToast"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="28,16"
            Background="#E6B453"
            BorderBrush="{StaticResource PrimaryDeepBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Opacity="0"
            IsHitTestVisible="False"
            Visibility="Collapsed"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <CompositeTransform />
            </Border.RenderTransform>
            <TextBlock
                x:Name="ModeToastText"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource InkBrush}"
                Text="已切换为「自定义设置」模式" />
        </Border>
    </Grid>
</Page>
